# Githuv server — copy to .env (cp .env.example .env) and fill in your values.

MongoDB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>

# Server port
PORT=4002

# Comma-separated origins allowed by CORS (dev + prod)
CLIENT_URL="http://localhost:3000,https://githuv.netlify.app"

# JWT signing secret (must match microservices/chat-service/.env)
JWT_SERVER_SECREAT=<random-secret>

# Firebase Admin SDK service account JSON (single line)
serviceAccount={"type":"service_account","project_id":"<project-id>","private_key_id":"<key-id>","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"<sdk-email>","client_id":"<client-id>","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","universe_domain":"googleapis.com"}

# Google AI / Gemini API key (README / profile / resume generation)
GOOGLE_API_KEY=<google-api-key>

# GitHub token for AI model access
GITHUB_ACCESS_TOKEN=<github-token>

# PDF microservice URL — must match PORT in microservices/pdf-service/.env
PDF_SERVICE_URL=http://localhost:3005

CLOUDINARY_CLOUD_NAME=<cloud-name>
CLOUDINARY_API_KEY=<api-key>
CLOUDINARY_API_SECRET=<api-secret>
