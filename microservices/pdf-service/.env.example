# PDF service URLs — copy to .env (cp .env.example .env) and adjust.
# Bun loads .env automatically (`bun run dev` / `bun run start:tex-pdf`).

# Port for the Express /compile service (server/.env PDF_SERVICE_URL must match this)
PORT=3005

# Port for the standalone Bun.serve /convert service
TEX_PDF_PORT=3001

# Public URL of this service, as reached by the Githuv server
PDF_SERVICE_URL=http://localhost:3005
