# Githuv chat service — copy to .env (cp .env.example .env) and fill in your values.

MongoDB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>

# JWT signing secret (must match server/.env)
JWT_SERVER_SECREAT=<random-secret>

CLOUDINARY_CLOUD_NAME=<cloud-name>
CLOUDINARY_API_KEY=<api-key>
CLOUDINARY_API_SECRET=<api-secret>
